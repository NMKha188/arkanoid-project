<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx/21.0.8"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="arkanoid.source.code.SceneController"
      alignment="CENTER"
      spacing="30"
      prefHeight="640"
      prefWidth="560"
      style="-fx-background-color: #2c3e50;">

    <padding>
        <Insets top="50" right="50" bottom="50" left="50"/>
    </padding>

    <!-- Game Title -->
    <VBox alignment="CENTER" spacing="10">
        <Label text="ARKANOID" textFill="white">
            <font>
                <Font name="Arial Bold" size="48" />
            </font>
        </Label>
        <Label text="Classic Arcade Game" textFill="#ecf0f1" style="-fx-font-size: 16px;"/>
    </VBox>

    <!-- Menu Buttons -->
    <VBox alignment="CENTER" spacing="15">
        <Button fx:id="playButton"
                text="PLAY GAME"
                prefWidth="200"
                prefHeight="50"
                style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold; -fx-background-radius: 25;"/>

        <Button fx:id="exitButton"
                text="EXIT"
                prefWidth="200"
                prefHeight="50"
                style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold; -fx-background-radius: 25;"/>
    </VBox>

    <!-- Instructions -->
    <Label text="Use LEFT/RIGHT arrows to move paddle • SPACE to release ball"
           textFill="#bdc3c7"
           style="-fx-font-size: 14px;"/>

</VBox>
